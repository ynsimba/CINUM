# 5001 évite le conflit avec AirPlay (macOS) sur le port 5000.
PORT=5001
# Ajoutez ?connect_timeout=8 pour limiter l’attente si la base est injoignable (recommandé en dev)
DATABASE_URL="postgresql://USER:PASSWORD@localhost:5432/cinum?connect_timeout=8"
JWT_SECRET=changez_ce_secret_en_production_minimum_32_caracteres
CLIENT_ORIGIN=http://localhost:5173
NODE_ENV=development

# Désactiver JWT + rôles sur /api/admin (uniquement en dev — jamais en production)
# DISABLE_ADMIN_AUTH=true

# URL publique du site (e-mails de signalement, liens)
PUBLIC_SITE_URL=http://localhost:5173

# E-mails (nodemailer) — laisser vide en dev pour désactiver l’envoi
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
SMTP_FROM=noreply@exemple.cd
# Destinataires alerte nouveau signalement (séparés par des virgules)
ADMIN_NOTIFY_EMAIL=

# Seed (npm run seed) — identifiants créés en base pour /connexion → /admin
SEED_ADMIN_EMAIL=admin@cinum-rdc.local
SEED_ADMIN_PASSWORD=ChangeMoi2026!Securise
SEED_MOD_EMAIL=moderateur@cinum-rdc.local
SEED_MOD_PASSWORD=Moderateur2026!
# Si les comptes existent déjà, les mots de passe ne changent pas sauf si :
# SEED_UPDATE_PASSWORDS=true
