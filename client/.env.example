# URL publique du site (sans slash final), pour balises canonical et Open Graph.
# Exemple : https://www.exemple.cd
VITE_SITE_URL=

# Dev : cible du proxy Vite pour /api et /uploads — doit être identique à PORT dans server/.env.
# Défaut Vite si absent : http://127.0.0.1:5001. Ex. si server/.env a PORT=5000 :
# VITE_DEV_API_TARGET=http://127.0.0.1:5000

# Consentement : le choix est enregistré en cookie first-party `cinum_consent` (essential | all),
# synchronisé avec localStorage pour compatibilité. En HTTPS, le cookie est marqué Secure.

# Matomo (auto-hébergé) — chargé uniquement après consentement « Accepter » (cinum_consent=all).
# URL de base du serveur Matomo, sans slash final. Exemple : https://stats.exemple.cd
VITE_MATOMO_URL=
# Identifiant du site dans Matomo (nombre).
VITE_MATOMO_SITE_ID=
